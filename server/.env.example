# Application
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false

# Local database default. Keep real credentials out of this file.
DATABASE_URL=sqlite:///./videos.db

# Host paths used by docker-compose.yml; choose a persistent data directory.
MYTEAM_DATA_DIR=./data
MYTEAM_BIND_ADDRESS=127.0.0.1
MYTEAM_HTTP_PORT=8000
MYTEAM_SERVER_IMAGE=myteam-server:local

# Container storage paths
STORAGE_PATH=/app/storage
VIDEOS_PATH=/app/storage/videos
THUMBNAILS_PATH=/app/storage/thumbnails
QUALITIES_PATH=/app/storage/qualities

# Resolve tools from PATH. Override only when your installation requires it.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

MAX_UPLOAD_SIZE=53687091200
MAX_CONCURRENT_UPLOADS=30
UPLOAD_TIMEOUT=86400
MAX_RETRIES_BACKGROUND_TASKS=5
METADATA_EXTRACTION_TIMEOUT=3600
THUMBNAIL_GENERATION_TIMEOUT=600
DEFAULT_THUMBNAIL_PATH=/app/storage/default_thumbnail.jpg

# Local development only. Set exact HTTPS web-client origins before deployment.
CORS_ORIGINS=http://localhost:3000
